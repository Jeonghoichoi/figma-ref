// Synthetic schema shaped like the one embedded in .fig files (subset).
// Only used for tests; real schemas are always read from the file itself.

enum MessageType {
  JOIN_START = 0;
  NODE_CHANGES = 1;
}

enum NodeType {
  NONE = 0;
  DOCUMENT = 1;
  CANVAS = 2;
  GROUP = 3;
  FRAME = 4;
  RECTANGLE = 10;
  TEXT = 13;
}

enum PaintType {
  SOLID = 0;
  GRADIENT_LINEAR = 1;
  IMAGE = 5;
}

enum NodePhase {
  CREATED = 0;
  REMOVED = 1;
}

enum BlendMode {
  PASS_THROUGH = 0;
  NORMAL = 1;
  MULTIPLY = 3;
}

enum StrokeAlign {
  CENTER = 0;
  INSIDE = 1;
  OUTSIDE = 2;
}

enum EffectType {
  INNER_SHADOW = 0;
  DROP_SHADOW = 1;
}

enum WindingRule {
  NONZERO = 0;
  ODD = 1;
}

enum ImageScaleMode {
  STRETCH = 0;
  FIT = 1;
  FILL = 2;
  TILE = 3;
}

enum NumberUnits {
  RAW = 0;
  PIXELS = 1;
  PERCENT = 2;
}

enum TextAlignHorizontal {
  LEFT = 0;
  CENTER = 1;
  RIGHT = 2;
  JUSTIFIED = 3;
}

enum TextAlignVertical {
  TOP = 0;
  CENTER = 1;
  BOTTOM = 2;
}

enum LineType {
  PLAIN = 0;
}

enum SourceDirectionality {
  AUTO = 0;
}

struct GUID {
  uint sessionID;
  uint localID;
}

struct Color {
  float r;
  float g;
  float b;
  float a;
}

struct Vector {
  float x;
  float y;
}

struct FontName {
  string family;
  string style;
  string postscript;
}

struct Number {
  float value;
  NumberUnits units;
}

struct ColorStop {
  Color color;
  float position;
}

struct Matrix {
  float m00;
  float m01;
  float m02;
  float m10;
  float m11;
  float m12;
}

message ParentIndex {
  GUID guid = 1;
  string position = 2;
}

message Image {
  byte[] hash = 1;
  string name = 2;
}

message Paint {
  PaintType type = 1;
  Color color = 2;
  float opacity = 3;
  bool visible = 4;
  BlendMode blendMode = 5;
  ColorStop[] stops = 6;
  Matrix transform = 7;
  Image image = 8;
  ImageScaleMode imageScaleMode = 9;
}

message Effect {
  EffectType type = 1;
  Color color = 2;
  Vector offset = 3;
  float radius = 4;
  bool visible = 5;
  BlendMode blendMode = 6;
  float spread = 7;
}

message Path {
  WindingRule windingRule = 1;
  uint commandsBlob = 2;
  uint styleID = 3;
}

message TextLineData {
  LineType lineType = 1;
  int styleId = 2;
  int indentationLevel = 3;
  SourceDirectionality sourceDirectionality = 4;
  int listStartOffset = 5;
  bool isFirstLineOfList = 6;
}

message TextData {
  string characters = 1;
  TextLineData[] lines = 2;
  uint[] characterStyleIDs = 3;
}

message SymbolData {
  GUID symbolID = 1;
}

message NodeChange {
  GUID guid = 1;
  ParentIndex parentIndex = 2;
  NodeType type = 3;
  string name = 4;
  bool visible = 5;
  float opacity = 6;
  Vector size = 7;
  Matrix transform = 8;
  Paint[] fillPaints = 9;
  TextData textData = 10;
  int cornerRadiusDelta = 11;
  int64 sessionTimestamp = 12;
  uint64 objectHash = 13;
  NodePhase phase = 14;
  bool locked = 15;
  BlendMode blendMode = 16;
  Paint[] strokePaints = 17;
  float strokeWeight = 18;
  StrokeAlign strokeAlign = 19;
  Effect[] effects = 20;
  float cornerRadius = 21;
  bool frameMaskDisabled = 22;
  bool resizeToFit = 23;
  Path[] fillGeometry = 24;
  Path[] strokeGeometry = 25;
  float fontSize = 26;
  FontName fontName = 27;
  Number lineHeight = 28;
  Number letterSpacing = 29;
  float textTracking = 30;
  TextAlignHorizontal textAlignHorizontal = 31;
  TextAlignVertical textAlignVertical = 32;
  SymbolData symbolData = 33;
}

message Blob {
  byte[] bytes = 1;
}

message Message {
  MessageType type = 1;
  uint sessionID = 2;
  uint ackID = 3;
  NodeChange[] nodeChanges = 4;
  Blob[] blobs = 5;
}
